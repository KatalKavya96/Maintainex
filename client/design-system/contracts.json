{
  "design-system.Button": {
    "revision": 1,
    "variants": [
      "primary",
      "secondary",
      "ghost",
      "danger",
      "sm",
      "md"
    ],
    "states": [
      "default",
      "hover",
      "focus-visible",
      "disabled"
    ],
    "description": "Native button or navigational link. Explicit variants own the action styling.",
    "review": "implemented and catalogued"
  },
  "design-system.Badge": {
    "revision": 1,
    "variants": [
      "neutral",
      "accent",
      "danger"
    ],
    "states": [
      "default"
    ],
    "description": "Text-first semantic badge; no arbitrary feature colors.",
    "review": "implemented and catalogued"
  },
  "design-system.Input": {
    "revision": 1,
    "variants": [
      "text",
      "native input types"
    ],
    "states": [
      "default",
      "focus-visible",
      "invalid",
      "disabled"
    ],
    "review": "implemented and catalogued"
  },
  "design-system.Select": {
    "revision": 1,
    "variants": [
      "native select"
    ],
    "states": [
      "default",
      "focus-visible",
      "disabled"
    ],
    "review": "implemented and catalogued"
  },
  "design-system.Textarea": {
    "revision": 1,
    "variants": [
      "resizable"
    ],
    "states": [
      "default",
      "focus-visible",
      "invalid",
      "disabled"
    ],
    "review": "implemented and catalogued"
  },
  "design-system.Field": {
    "revision": 1,
    "variants": [
      "label",
      "hint",
      "error"
    ],
    "states": [
      "default",
      "invalid"
    ],
    "review": "implemented and catalogued"
  },
  "design-system.PageHeader": {
    "revision": 1,
    "variants": [
      "title",
      "description",
      "eyebrow",
      "actions"
    ],
    "states": [
      "default",
      "narrow layout"
    ],
    "review": "implemented and catalogued"
  },
  "design-system.Metric": {
    "revision": 1,
    "variants": [
      "value",
      "detail",
      "icon"
    ],
    "states": [
      "default",
      "zero"
    ],
    "description": "Neutral value; no invented trends or context labels.",
    "review": "implemented and catalogued"
  },
  "design-system.EmptyState": {
    "revision": 1,
    "variants": [
      "explanation",
      "action"
    ],
    "states": [
      "empty",
      "filtered empty"
    ],
    "review": "implemented and catalogued"
  },
  "design-system.AsyncState": {
    "revision": 1,
    "variants": [
      "loading",
      "error",
      "empty",
      "ready"
    ],
    "states": [
      "loading",
      "error",
      "empty",
      "ready"
    ],
    "review": "implemented and catalogued"
  },
  "design-system.Surface": {
    "revision": 1,
    "variants": [
      "section"
    ],
    "states": [
      "default"
    ],
    "review": "implemented and catalogued"
  },
  "design-system.Toolbar": {
    "revision": 1,
    "variants": [
      "wrapping group"
    ],
    "states": [
      "default",
      "narrow layout"
    ],
    "review": "implemented and catalogued"
  },
  "design-system.DataTable": {
    "revision": 1,
    "variants": [
      "typed columns",
      "native table"
    ],
    "states": [
      "populated",
      "horizontal overflow"
    ],
    "description": "Callers own empty/loading states and row actions. No data fetching.",
    "review": "implemented and catalogued"
  },
  "design-system.ViewSwitcher": {
    "revision": 1,
    "variants": [
      "default"
    ],
    "states": [
      "selected",
      "unselected",
      "focus-visible",
      "narrow layout"
    ],
    "description": "Native button group with aria-pressed. Wraps at narrow widths; no tab-panel keyboard contract.",
    "review": "implemented and catalogued"
  },
  "design-system.Pagination": {
    "revision": 1,
    "variants": [
      "default"
    ],
    "states": [
      "first page",
      "middle page",
      "last page",
      "empty",
      "loading"
    ],
    "description": "Controlled one-based pagination. Caller owns requests and total scope. Native Previous/Next controls disable at boundaries and during requests.",
    "review": "implemented and catalogued"
  },
  "design-system.Feedback": {
    "revision": 1,
    "variants": [
      "default"
    ],
    "states": [
      "error",
      "success"
    ],
    "description": "Text feedback; errors use alert and success uses status. Does not own persistence.",
    "review": "implemented and catalogued"
  },
  "design-system.Dialog": {
    "revision": 1,
    "variants": [
      "default"
    ],
    "states": [
      "closed",
      "open"
    ],
    "description": "Modal on native <dialog>: focus stays inside, Escape and backdrop click call onClose, title labels the dialog. Owns no data; children own their forms and errors.",
    "review": "implemented and catalogued"
  }
}
